# BackendAPI environment variables (configure without committing secrets)
BACKEND_DB_URL=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
BACKEND_JWT_SECRET=<strong-random-secret>
BACKEND_JWT_EXPIRE_MINUTES=120
BACKEND_JWT_ALG=HS256

# Frontend->Backend CORS origin
REACT_APP_FRONTEND_URL=http://localhost:3000

# Frontend API base (used by the React app; place in the frontend container .env)
REACT_APP_API_BASE=http://localhost:3001
REACT_APP_BACKEND_URL=http://localhost:3001

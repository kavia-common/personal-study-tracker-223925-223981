# BackendAPI environment variables (example)
# Copy this file to .env and fill in the values. Do not commit the .env file.

# Application
REACT_APP_FRONTEND_URL=http://localhost:3000

# API base URL (used by frontend; documented here for reference)
REACT_APP_API_BASE=http://localhost:3001

# Database (Preferred)
# PostgreSQL DSN example:
# postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/studytracker

# Alternative (fallback) key if your environment uses legacy naming
# BACKEND_DB_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/studytracker

# JWT
# Provide a strong random secret in production (e.g., from a secret manager)
BACKEND_JWT_SECRET=change-me-in-production
# Algorithm (HS256 is default)
BACKEND_JWT_ALG=HS256
# Minutes until access token expiration
BACKEND_JWT_EXPIRE_MINUTES=120

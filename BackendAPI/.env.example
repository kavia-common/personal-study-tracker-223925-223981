# BackendAPI environment configuration
# NOTE: Do not commit real secrets to version control.

# Database connection URL (SQLAlchemy style)
# Preferred var:
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/personal_study_tracker
# Backward-compatible fallback (read if DATABASE_URL not set)
# BACKEND_DB_URL=postgresql+psycopg2://postgres:password@localhost:5432/personal_study_tracker

# JWT configuration
BACKEND_JWT_SECRET=change-me-in-prod
BACKEND_JWT_ALG=HS256
BACKEND_JWT_EXPIRE_MINUTES=120

# CORS: Frontend origin
REACT_APP_FRONTEND_URL=http://localhost:3000

# BackendAPI environment configuration (do NOT commit real secrets)

# API server
REACT_APP_PORT=3001
REACT_APP_NODE_ENV=development
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/
REACT_APP_TRUST_PROXY=false

# CORS - Frontend origin allowed
REACT_APP_FRONTEND_URL=http://localhost:3000

# API base URL (for frontend documentation/reference)
REACT_APP_API_BASE=http://localhost:3001
REACT_APP_BACKEND_URL=http://localhost:3001
REACT_APP_WS_URL=

# Security / JWT
# Generate a strong random secret for production deployments
BACKEND_JWT_SECRET=please-change-me
BACKEND_JWT_ALG=HS256
BACKEND_JWT_EXPIRE_MINUTES=120

# Database
# Prefer DATABASE_URL; example for PostgreSQL:
# postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=
# Optional legacy fallback if needed by environment
BACKEND_DB_URL=

# Feature flags, experiments
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false

# Telemetry
REACT_APP_NEXT_TELEMETRY_DISABLED=true

# Source maps in production builds (frontend)
REACT_APP_ENABLE_SOURCE_MAPS=false
